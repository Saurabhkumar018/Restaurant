<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GourmetHub - Restaurant Ordering System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
   <link rel="stylesheet" href="/css/index.css">
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <i class="fas fa-utensils"></i>
                    <h1>GourmetHub</h1>
                </div>
                <nav>
                    <ul>
                        <li><a href="#" onclick="showOrderingPage()">Order</a></li>
                        <li><a href="#" onclick="showReceiptPage()">Receipt</a></li>
                        <li><a href="#" onclick="showOrderHistory()">Order History</a></li>
                        <li><a href="#" onclick="showItemManagement()">Manage Items</a></li>
                        <li class="cart-icon" onclick="toggleCart()">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="cart-count">0</span>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <!-- Ordering Page -->
    <div id="ordering-page">
        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <h2>Delicious Food Delivered To You</h2>
                <p>Experience the best flavors from around the world, prepared by our master chefs and delivered to your doorstep.</p>
                <a href="#customer-form" class="btn">Start Ordering</a>
            </div>
        </section>

        <!-- Customer Information Form -->
        <section id="customer-form">
            <div class="container">
                <div class="customer-form-container">
                    <h2 class="form-title">Customer Information</h2>
                    <form id="customer-info-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="name">Full Name</label>
                                <input type="text" id="name" name="name" required placeholder="Enter your full name">
                            </div>
                            <div class="form-group">
                                <label for="mobile">Mobile Number</label>
                                <input type="tel" id="mobile" name="mobile" required placeholder="Enter your mobile number">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="table">Table Number</label>
                            <input type="text" id="table" name="table" required placeholder="Enter your table number">
                        </div>
                        <button type="submit" class="btn">Save Information & Start Ordering</button>
                    </form>
                    <div class="form-note">
                        <p><i class="fas fa-info-circle"></i> Please provide your information before adding items to your cart. This helps us serve you better.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Menu Section -->
        <section id="menu">
            <div class="container">
                <h2 class="section-title">Our Menu</h2>
                <div class="categories">
                    <button class="category-btn active" data-category="all">All</button>
                    <button class="category-btn" data-category="starters">Starters</button>
                    <button class="category-btn" data-category="mains">Main Courses</button>
                    <button class="category-btn" data-category="desserts">Desserts</button>
                    <button class="category-btn" data-category="drinks">Drinks</button>
                </div>
                <div class="menu-items">
                    <!-- Menu items will be populated by JavaScript -->
                </div>
            </div>
        </section>

        <!-- Cart Modal -->
        <div class="modal" id="cart-modal">
            <div class="modal-content">
                <span class="close-modal" onclick="toggleCart()">&times;</span>
                <h2>Your Order</h2>
                
                <div class="customer-info-summary">
                    <h4>Customer Information</h4>
                    <p id="summary-name">Name: Not provided</p>
                    <p id="summary-mobile">Mobile: Not provided</p>
                    <p id="summary-table">Table: Not provided</p>
                </div>
                
                <div class="cart-items">
                    <!-- Cart items will be populated by JavaScript -->
                </div>
                <div class="cart-total">
                    <span>Total:</span>
                    <span id="cart-total-price">₹0.00</span>
                </div>
                <button class="checkout-btn" onclick="confirmOrder()">Confirm Order</button>
                <button class="btn btn-receipt" onclick="generateReceipt()">Generate Receipt</button>
            </div>
        </div>
    </div>

    <!-- Receipt Page -->
    <div id="receipt-page" class="hidden">
        <div class="container">
            <div class="receipt-container">
                <div class="receipt-header">
                    <h2>GourmetHub Restaurant</h2>
                    <p>Order Receipt</p>
                </div>
                
                <div class="receipt-info">
                    <div class="receipt-customer">
                        <h3>Customer Information</h3>
                        <p id="receipt-customer-name">Name: </p>
                        <p id="receipt-customer-mobile">Mobile: </p>
                        <p id="receipt-customer-table">Table: </p>
                    </div>
                    
                    <div class="receipt-order">
                        <h3>Order Information</h3>
                        <p id="receipt-order-number">Order #: </p>
                        <p id="receipt-order-date">Date: </p>
                        <p id="receipt-order-time">Time: </p>
                    </div>
                </div>
                
                <div class="receipt-items">
                    <h3>Order Items</h3>
                    <div id="receipt-items-list">
                        <!-- Receipt items will be populated by JavaScript -->
                    </div>
                </div>
                
                <div class="receipt-total">
                    <span>Total:</span>
                    <span id="receipt-total-amount">₹0.00</span>
                </div>
                
                <div class="receipt-footer">
                    <p>Thank you for dining with us!</p>
                    <p>We hope to see you again soon.</p>
                </div>
                
                <div class="action-buttons">
                    <button class="btn" onclick="printReceipt()">
                        <i class="fas fa-print"></i> Print Receipt
                    </button>
                    <button class="btn" onclick="newOrder()">
                        <i class="fas fa-utensils"></i> New Order
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Order History Page -->
    <div id="order-history-page" class="hidden">
        <div class="container">
            <div class="order-history">
                <h2>Order History</h2>
                <p>View and print receipts for your previous orders</p>
                
                <div class="order-list" id="order-list">
                    <!-- Order history will be populated by JavaScript -->
                </div>
                
                <div class="action-buttons">
                    <button class="btn" onclick="showOrderingPage()">
                        <i class="fas fa-utensils"></i> Back to Menu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Item Management Page -->
    <div id="item-management-page" class="hidden">
        <div class="container">
            <div class="item-management">
                <div class="management-header">
                    <h2>Menu Item Management</h2>
                    <button class="btn" onclick="showAddItemForm()">
                        <i class="fas fa-plus"></i> Add New Item
                    </button>
                </div>
                
                <table class="items-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="items-table-body">
                        <!-- Items will be populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add/Edit Item Form Page -->
    <div id="item-form-page" class="hidden">
        <div class="container">
            <div class="item-form-container">
                <h2 class="form-title" id="item-form-title">Add New Menu Item</h2>
                <form id="item-form">
                    <input type="hidden" id="item-id" value="">
                    <div class="form-group">
                        <label for="item-name">Item Name</label>
                        <input type="text" id="item-name" required placeholder="Enter item name">
                    </div>
                    <div class="form-group">
                        <label for="item-category">Category</label>
                        <select id="item-category" required>
                            <option value="">Select Category</option>
                            <option value="starters">Starters</option>
                            <option value="mains">Main Courses</option>
                            <option value="desserts">Desserts</option>
                            <option value="drinks">Drinks</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="item-price">Price (₹)</label>
                        <input type="number" id="item-price" min="0" step="0.01" required placeholder="Enter price">
                    </div>
                    <div class="form-group">
                        <label for="item-description">Description</label>
                        <textarea id="item-description" required placeholder="Enter item description"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="item-image">Image URL</label>
                        <input type="text" id="item-image" required placeholder="Enter image URL">
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-cancel" onclick="cancelItemForm()">Cancel</button>
                        <button type="submit" class="btn-save">Save Item</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>About Us</h3>
                    <p>GourmetHub brings you the finest dining experience with a diverse menu crafted by our award-winning chefs.</p>
                </div>
                <div class="footer-section">
                    <h3>Contact Info</h3>
                    <p><i class="fas fa-map-marker-alt"></i> 123 Food Street, Culinary City</p>
                    <p><i class="fas fa-phone"></i> (123) 456-7890</p>
                    <p><i class="fas fa-envelope"></i> info@gourmethub.com</p>
                </div>
                <div class="footer-section">
                    <h3>Quick Links</h3>
                    <ul>
                        <li><a href="#" onclick="showOrderingPage()">Order</a></li>
                        <li><a href="#" onclick="showReceiptPage()">Receipt</a></li>
                        <li><a href="#" onclick="showOrderHistory()">Order History</a></li>
                        <li><a href="#" onclick="showItemManagement()">Manage Items</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Follow Us</h3>
                    <div class="social-icons">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-pinterest"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2023 GourmetHub. All rights reserved.</p>
            </div>
        </div>
    </footer>

   <script src="/js/index.js"></script>
</body>
</html>